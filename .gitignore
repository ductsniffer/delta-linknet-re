# Build output and host tools
firmware/.pio/
firmware/dist/
tools/esptool/
__pycache__/
.venv/

# The update password generated by scripts/provision.ps1 (the Wi-Fi settings
# themselves never leave the board)
secrets/

# New recordings stay local; only the reference captures are committed.
captures/*
!captures/README.md
!captures/phase1-usb/
!captures/phase2-esp32/
captures/**/analysis-*/
captures/**/*.pcap
